{
  "name": "@grafana/azure-sdk",
  "version": "0.1.0",
  "description": "Common Azure features for Grafana",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "yarn bundle --watch --watch.onStart=\"yarn typecheck\"",
    "build": "yarn clean && yarn typecheck && yarn bundle",
    "bundle": "rollup -c rollup.config.ts --configPlugin typescript --configImportAttributesKey with",
    "clean": "rimraf ./dist ./compiled",
    "lint": "eslint --cache .",
    "prettier:check": "prettier --check --list-different=false --log-level=warn \"**/*.{ts,tsx,scss,md,mdx,json}\"",
    "prettier:write": "prettier --list-different \"**/*.{js,ts,tsx,scss,md,mdx,json}\" --write",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "typecheck": "tsc -p ./tsconfig.build.json",
    "test": "jest --notify --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "url": "http://github.com/grafana/grafana-azure-sdk-react.git"
  },
  "author": "Grafana Labs <team@grafana.com> (https://grafana.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@grafana/data": "12.4.5",
    "@grafana/eslint-config": "8.2.0",
    "@grafana/runtime": "12.4.5",
    "@grafana/tsconfig": "2.2.0",
    "@grafana/ui": "12.4.5",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "18.3.31",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "babel-jest": "30.4.1",
    "cspell": "9.8.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "60.8.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "6.1.1",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "node-notifier": "10.0.1",
    "prettier": "3.9.5",
    "react": "18.3.1",
    "rimraf": "6.1.3",
    "rollup": "4.62.2",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-node-externals": "8.1.2",
    "rollup-plugin-sourcemaps": "0.6.3",
    "rollup-plugin-visualizer": "6.0.11",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.2.3",
    "protobufjs": "7.6.5",
    "flatted": "3.4.2",
    "@isaacs/brace-expansion": "5.0.1",
    "immutable": "5.1.9",
    "handlebars": "4.7.9"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "packageManager": "yarn@4.17.1"
}
